{
  "compilerOptions": {
    // "target": "es2022",
    // "module": "es2022",
    // "moduleResolution": "Bundler",
    "target": "es2022",
    "module": "commonjs",
    "forceConsistentCasingInFileNames": true,

    "rootDir": "src",
    "outDir": "dist",

    "paths": {
      "@/*": ["./src/*"]
    },

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "prisma.config.ts", "tests"]
}
