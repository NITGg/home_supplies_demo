model SupplierStoreAddress {
  id                 Int      @id @default(autoincrement())
  supplier_id        Int
  area_id            Int?
  default_max_orders Int? // baseline max orders for all slots (null = no limit)
  address_line_1     String?  @db.VarChar(191)
  address_line_2     String?  @db.VarChar(191)
  city               String?  @db.VarChar(191)
  state              String?  @db.VarChar(191)
  country            String?  @default("Egypt") @db.VarChar(191)
  google_map_link    String?  @db.VarChar(191)
  latitude           Decimal? @db.Decimal(10, 8)
  longitude          Decimal? @db.Decimal(11, 8)
  contact_name       String?  @db.VarChar(191)
  contact_phone      String?  @db.VarChar(191)
  working_hours      Json?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  // Relations
  supplier      Supplier?              @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  area          Area?                  @relation(fields: [area_id], references: [id])
  // pickupAssignments OrderAssignment[] @relation("PickupAddress")
  // orderAssignments OrderAssignment[]
  orders        Order[]
  slotMaxOrders SupplierSlotMaxOrder[]

  @@map("supplier_store_address")
}

