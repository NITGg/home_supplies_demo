model Supplier {
  id                               Int      @id @default(autoincrement())
  user_id                          Int      @unique // courier belongs to a user account
  type_id                          Int?     @default(1)
  national_id_photo_front          String?  @db.VarChar(255)
  national_id_photo_back           String?  @db.VarChar(255)
  national_id_number               String?  @db.VarChar(40)
  supplier_criminal_record         String?  @db.VarChar(255)
  synonyms                         String?  @db.VarChar(191)
  tax_card                         String   @db.VarChar(191)
  commercial_register              String   @db.VarChar(191)
  is_approved                      Boolean? @default(false)
  markup_ratio                     Float?   @default(1.3) // selling price = cost_price × markup_ratio
  min_price_for_one_order          Decimal? @default(5000) @db.Decimal(10, 2)
  max_price_for_one_order          Decimal? @default(100000) @db.Decimal(10, 2)
  shopping_min_price_for_one_order Decimal? @default(5000) @db.Decimal(10, 2)
  shopping_max_price_for_one_order Decimal? @default(100000) @db.Decimal(10, 2)
  shopping_budget_fee              Float?   @default(5)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  // relations
  user                        User                         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type                        SupplierType?                @relation(fields: [type_id], references: [id])
  addresses                   SupplierStoreAddress[]
  contracts                   Contract[]
  stats                       SupplierStat?
  courierReviewsFromSupplier  CourierReviewFromSupplier[]
  supplierReviewsFromCustomer SupplierReviewFromCustomer[]
  supplierReviewsFromCourier  SupplierReviewFromCourier[]
  orders                      Order[]
  products                    SupplierProduct[] // Link to the junction table
  categories                  SupplierCategory[]
  // complaints            Complaint[]
  // handoverConfirmations SupplierHandoverConfirmation[]

  @@map("supplier")
}
