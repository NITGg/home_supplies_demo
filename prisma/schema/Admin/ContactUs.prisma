model ContactUs {
  id         Int       @id @default(autoincrement())
  name       String
  email      String
  message    String    @db.Text
  response   String?   @db.Text
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  read_at    DateTime?
  read       Boolean   @default(false)

  @@map("contact_us")
}
