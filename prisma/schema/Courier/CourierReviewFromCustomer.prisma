model CourierReviewFromCustomer {
  id          Int       @id @default(autoincrement())
  courier_id  Int
  customer_id Int
  order_id    Int?
  rating      Int
  comment     String?   @db.Text
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt

  // relations
  courier  Courier @relation(fields: [courier_id], references: [id], onDelete: Cascade)
  customer User?   @relation(map: "courier_review_from_customer_customer_id_fkey", fields: [customer_id], references: [id], onDelete: Cascade)
  order    Order?  @relation(fields: [order_id], references: [id])

  @@index([courier_id])
  @@index([customer_id])
  @@map("courier_review_from_customer")
}
