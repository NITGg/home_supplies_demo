model Escrow {
  id          Int       @id @default(autoincrement())
  order_id    Int?
  wallet_id   Int?
  held_amount Decimal   @db.Decimal(12, 2)
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt

  order        Order?        @relation(fields: [order_id], references: [id])
  wallet       Wallet?       @relation(fields: [wallet_id], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([order_id])
  @@index([wallet_id])
  @@map("escrow")
}
