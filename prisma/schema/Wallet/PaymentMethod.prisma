model PaymentMethod {
  id                         Int               @id @default(autoincrement())
  user_id                    Int? // NULL for platform
  method_type                PaymentMethodType
  provider                   Provider?
  instapay_number            String?           @db.VarChar(50)
  mobile_wallet_number       String?           @db.VarChar(50)
  provider_customer_id       String?           @db.VarChar(100)
  provider_payment_method_id String?           @db.VarChar(100)
  display_name               String?           @db.VarChar(50)
  is_default                 Boolean           @default(false)
  created_at                 DateTime          @default(now())
  updated_at                 DateTime?         @updatedAt
  deleted_at                 DateTime?

  user         User?         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([user_id])
  @@map("payment_method")
}

enum PaymentMethodType {
  BANK_ACCOUNT
  INSTAPAY
  MOBILE_WALLET
}

enum Provider {
  PAYMOB
  KASHIER
  EASYKASH
  MANUAL
}
