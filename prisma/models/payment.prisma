enum TransactionType {
  TOPUP
  ORDER_PAYMENT
  CARD_PAYMENT_RECEIVED
  WITHDRAWAL
  ESCROW_HOLD
  ESCROW_RELEASE
  ESCROW_REMOVE
  PLATFORM_COD_COMMISSION
  PENALTY
  WAIVE_PENALTY
  COUPON_PURCHASE
  MANUAL_INCREASE
  MANUAL_DECREASE
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REJECTED
  WAIVED
}

enum PaymentMethodType {
  BANK_ACCOUNT
  INSTAPAY
  MOBILE_WALLET
}

enum TransferMethod {
  STANDARD
  INSTAPAY
}

model UnpaidCommission {
  id         Int       @id @default(autoincrement())
  order_id   Int       @unique
  user_id    Int?
  amount     Decimal   @db.Decimal(10, 2)
  is_paid    Boolean   @default(false)
  created_at DateTime  @default(now())
  paid_at    DateTime?

  order         Order         @relation(fields: [order_id], references: [id])
  courier       User?         @relation("UserUnpaidCommissions", fields: [user_id], references: [id], onDelete: SetNull)
  walletEntries WalletEntry[]

  @@index([user_id])
  @@map("unpaid_commission")
}

model Penalty {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  created_by Int?
  amount     Decimal   @db.Decimal(10, 2)
  reason     String?   @db.VarChar(255)
  is_paid    Boolean   @default(false)
  paid_at    DateTime?
  is_waived  Boolean   @default(false)
  waived_at  DateTime?
  waived_by  Int?
  created_at DateTime  @default(now())

  user          User?         @relation("UserPenalties", fields: [user_id], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("PenaltyCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  waivedBy      User?         @relation("PenaltyWaivedBy", fields: [waived_by], references: [id], onDelete: SetNull)
  walletEntries WalletEntry[]

  @@index([user_id])
  @@index([created_by])
  @@map("penalty")
}

model Escrow {
  id          Int       @id @default(autoincrement())
  order_id    Int?
  wallet_id   Int?
  held_amount Decimal   @db.Decimal(12, 2)
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt

  order        Order?        @relation(fields: [order_id], references: [id])
  wallet       Wallet?       @relation(fields: [wallet_id], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([order_id])
  @@index([wallet_id])
  @@map("escrow")
}

enum Provider {
  PAYMOB
  KASHIER
  EASYKASH
  MANUAL
}

model PaymentMethod {
  id                         Int               @id @default(autoincrement())
  user_id                    Int? // NULL for platform
  method_type                PaymentMethodType
  provider                   Provider?
  instapay_number            String?           @db.VarChar(50)
  mobile_wallet_number       String?           @db.VarChar(50)
  provider_customer_id       String?           @db.VarChar(100)
  provider_payment_method_id String?           @db.VarChar(100)
  display_name               String?           @db.VarChar(50)
  is_default                 Boolean           @default(false)
  created_at                 DateTime          @default(now())
  updated_at                 DateTime?         @updatedAt
  deleted_at                 DateTime?

  user         User?         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([user_id])
  @@map("payment_method")
}

model Transaction {
  id                      Int               @id @default(autoincrement())
  wallet_id               Int?
  order_id                Int?
  escrow_id               Int?
  payment_method_id       Int?
  processed_by            Int?
  courier_point_batch_id  Int?
  customer_point_batch_id Int?
  type                    TransactionType
  status                  TransactionStatus @default(COMPLETED)
  reject_reason           String?           @db.VarChar(255)
  amount                  Decimal           @db.Decimal(12, 2)
  description             String?           @db.VarChar(255)
  paymob_order_id         String?           @db.VarChar(255)
  paymob_transaction_id   String?           @db.VarChar(255) // Paymob's obj.id — needed for refunds
  kashier_order_id        String?           @db.VarChar(255)
  easykash_ref            String?           @db.VarChar(255) // EasyKash easykashRef from callback
  checkout_url            String?           @db.VarChar(1000) // Gateway checkout/payment link, re-servable while PENDING
  customer_coupon_id      Int?

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  wallet             Wallet?             @relation(fields: [wallet_id], references: [id], onDelete: SetNull)
  order              Order?              @relation(fields: [order_id], references: [id])
  escrow             Escrow?             @relation(fields: [escrow_id], references: [id])
  paymentMethod      PaymentMethod?      @relation(fields: [payment_method_id], references: [id])
  processedBy        User?               @relation("TransactionProcessedBy", fields: [processed_by], references: [id], onDelete: SetNull)
  customerCoupon     CustomerCoupon?     @relation(fields: [customer_coupon_id], references: [id])
  courierPointBatch  CourierPointBatch?  @relation(fields: [courier_point_batch_id], references: [id])
  customerPointBatch CustomerPointBatch? @relation(fields: [customer_point_batch_id], references: [id])
  refund             Refund?

  @@index([wallet_id])
  @@index([order_id])
  @@index([escrow_id])
  @@index([payment_method_id])
  @@map("transaction")
}

