enum AppEnvironment {
  SANDBOX
  PRODUCTION
}

model ExternalApp {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(100)
  client_id     String         @unique @db.VarChar(64) // e.g., ca_live_...
  client_secret String         @db.VarChar(255) // Hashed
  environment   AppEnvironment @default(SANDBOX)

  webhook_url         String? @db.VarChar(255)
  webhook_secret      String? @db.VarChar(255) // Hashed
  webhook_version     Int     @default(1)
  webhook_retry_count Int     @default(3)

  is_active  Boolean  @default(true)
  partner_id Int? // Optional link to a Business/Partner table
  created_at DateTime @default(now())

  contracts     PartnerContract[]
  orders        Order[]
  wallet        Wallet? // ← back-relation
  webhookEvents WebhookEvent[]

  @@map("external_app")
}

model PartnerContract {
  id              Int      @id @default(autoincrement())
  external_app_id Int      @unique
  start_date      DateTime
  end_date        DateTime
  is_active       Boolean  @default(true)

  // Settings for this specific partner
  can_receive_courier_offers Boolean @default(true) // "Yes/No" from your table

  // Relations
  external_app    ExternalApp              @relation(fields: [external_app_id], references: [id])
  vehicle_configs PartnerContractVehicle[] // Config per vehicle

  @@map("partner_contract")
}

model PartnerContractVehicle {
  id          Int @id @default(autoincrement())
  contract_id Int
  vehicle_id  Int

  // Distance & Base Pricing (Same for all badges)
  min_fee       Decimal           @db.Decimal(10, 2)
  m_min         Float             @default(0)
  m_max         Float
  fee_per_m     Decimal           @db.Decimal(10, 4)
  extra_m_price Decimal           @db.Decimal(10, 4)
  // Specific Split Ratios based on Badge
  splits        PartnerFeeSplit[]

  contract PartnerContract @relation(fields: [contract_id], references: [id])
  vehicle  Vehicle         @relation(fields: [vehicle_id], references: [id])
  orders   Order[]

  @@unique([contract_id, vehicle_id])
  @@map("partner_contract_vehicle")
}

model PartnerFeeSplit {
  id                  Int @id @default(autoincrement())
  contract_vehicle_id Int
  badge_id            Int

  // The 3-way split ratios
  app_ratio     Float // e.g. 0.40
  courier_ratio Float // e.g. 0.50
  partner_ratio Float // e.g. 0.10

  contract_vehicle PartnerContractVehicle @relation(fields: [contract_vehicle_id], references: [id])
  badge            UserBadge              @relation(fields: [badge_id], references: [id])

  @@map("partner_fee_split")
}

model WebhookEvent {
  id String @id @default(cuid())

  external_app_id Int
  event_type      WebhookEventType

  payload Json

  delivery_status WebhookDeliveryStatus
  attempts        Int                   @default(0)

  last_attempt_at DateTime?
  delivered_at    DateTime?
  last_error      String?

  response_status Int?
  response_body   String? @db.Text

  created_at DateTime @default(now())

  externalApp ExternalApp @relation(fields: [external_app_id], references: [id])

  @@map("webhook_event")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum WebhookEventType {
  ORDER_CREATED
  ORDER_OFFER_SUBMITTED
  ORDER_OFFER_ACCEPTED
  ORDER_OFFER_REJECTED
  ORDER_COLLECTED
  ORDER_PRICE_CHANGED
  ORDER_DELIVERED
  ORDER_CANCELLED
  ORDER_EXPIRED
  ORDER_PAYMENT_CONFIRMED
  WALLET_RECHARGED
}
