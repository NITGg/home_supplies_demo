{
  "name": "tawreedat_supplierapis",
  "version": "1.0.0",
  "description": "Backend API services for the Tawreedat supplier application.",
  "main": "index.js",
  "scripts": {
    "build": "tsc && copyfiles -u 0 \"src/**/*.json\" dist",
    "start": "node ./dist/src/index.js",
    "dev": "concurrently \"tsc --noEmit --watch\" \"tsx watch src/index.ts\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:mig": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:gen": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seeds",
    "db:format": "prisma format",
    "db:*": "prisma format && prisma db push && prisma generate",
    "old:studio": "npx prisma@6.16.3 studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitgNITG/tawreedat_go.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nitgNITG/tawreedat_supplierAPIs/issues"
  },
  "homepage": "https://github.com/nitgNITG/tawreedat_supplierAPIs#readme",
  "dependencies": {
    "@prisma/adapter-mariadb": "7.3.0",
    "@prisma/client": "7.3.0",
    "@types/i18n": "0.13.12",
    "bcrypt": "6.0.0",
    "cloudinary": "^2.10.0",
    "concurrently": "^9.2.1",
    "cors": "2.8.6",
    "crypto-js": "4.2.0",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-rate-limit": "8.2.1",
    "firebase-admin": "13.7.0",
    "fuse.js": "^7.3.0",
    "google-auth-library": "10.5.0",
    "helmet": "8.1.0",
    "i18n": "0.15.3",
    "jsonwebtoken": "9.0.3",
    "jwks-rsa": "3.2.2",
    "multer": "2.0.2",
    "node-cron": "4.2.1",
    "nodemailer": "7.0.12",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "qrcode": "1.5.4",
    "sharp": "0.34.5",
    "socket.io": "4.8.3",
